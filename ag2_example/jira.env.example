# Copy this file to ag2_example/.env and fill in credentials for the Jira MCP server.
#
# The values depend on how your Jira instance is configured.  The official
# jira-mcp container expects the following environment variables:
#
#   JIRA_BASE_URL      - Base URL of the Jira instance (e.g. https://company.atlassian.net)
#   JIRA_EMAIL         - Email address associated with the Jira API token
#   JIRA_API_TOKEN     - Personal access token generated from Jira
#
# Additional variables can be appended as needed.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
