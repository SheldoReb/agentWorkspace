# Copy this file to ag2_example/.env.jira (or set JIRA_MCP_ENV_FILE to your own path)
# and fill in the values with credentials that the Jira MCP container understands.
# Refer to https://github.com/nguyenvanduocit/jira-mcp for the definitive list of variables.

ATLASSIAN_BASE_URL=https://your-domain.atlassian.net
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=your_api_token
# Optional: restrict the MCP server to a default project or board
JIRA_DEFAULT_PROJECT=PROJECTKEY

